# Copy to .env.local. Use your project's publishable key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable only after configuring each provider in Supabase and its developer console.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_FACEBOOK_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
